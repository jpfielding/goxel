#!/bin/bash

eval "$(starship init bash)"
# personal prefs
alias ls='ls --color'
alias ll='ls -al'

PATH="$HOME/go/bin:$HOME/sdk/go/bin:$PATH"

# update go version in place
go_to_version() {
    VERSION="$1"
    push3 ${HOME}/sdk && \
    go install golang.org/dl/go${VERSION}@latest && \
    go${VERSION} download && \
    rm go && ln -s go${VERSION} go
    popd
}